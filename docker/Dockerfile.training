ARG BASE_IMAGE=llm-base:latest
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace:/workspace/src

WORKDIR /workspace

COPY src /workspace/src
COPY scripts /workspace/scripts
COPY config /workspace/config
COPY requirements.txt /workspace/requirements.txt

RUN mkdir -p /workspace/data /workspace/models /workspace/outputs

# One torchrun job per training stage across every visible GPU; pass a stage
# (sft | reward | rlhf) to run only that one. Needs HF_TOKEN for Llama 3.
ENTRYPOINT ["bash", "/workspace/scripts/launch_training.sh"]
CMD ["all"]
